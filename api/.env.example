# Copy to api/.env (never commit .env). See docs/07-engineering/environment-setup.md.

# local / preview / production. AUTH_MODE=dev is refused unless APP_ENV=local.
APP_ENV=local

# Supabase. For the local stack, copy the values printed by `supabase status`.
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=
# Admin tasks only (storage cleanup, account purge). Never sent to the browser.
SUPABASE_SERVICE_ROLE_KEY=
# Verifies access tokens (and signs the dev user's token in AUTH_MODE=dev).
SUPABASE_JWT_SECRET=

# supabase = verify the caller's Supabase JWT; dev = act as the seeded dev user (local only).
AUTH_MODE=dev

# live = call OpenAI; fixture = recorded responses from tests/fixtures/llm (no key needed).
LLM_MODE=fixture
# Required when LLM_MODE=live.
OPENAI_API_KEY=

# Analysis model allowlist as id:label pairs (ADR-0006), and the default (must be listed).
ANALYSIS_MODELS=gpt-5.4-mini:Recommended,gpt-4.1-mini:Alternative
ANALYSIS_MODEL_DEFAULT=gpt-5.4-mini

# Per-call LLM timeout in seconds.
LLM_TIMEOUT_SECONDS=45

# Comma-separated allowed browser origins.
CORS_ORIGINS=http://localhost:5173
