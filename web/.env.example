# Copy to web/.env and adjust. See docs/07-engineering/environment-setup.md.
VITE_API_BASE_URL=http://localhost:8000/api/v1
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_ANON_KEY=
# supabase | dev  (dev = fake signed-in user, no Google sign-in; must match backend AUTH_MODE)
VITE_AUTH_MODE=dev
# true = answer API calls in the browser with MSW mock data (no backend needed)
VITE_API_MOCK=true
