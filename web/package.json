    "radix-ui": "^1.8.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router": "^7.18.4",
    "shadcn": "^4.22.1",
    "sonner": "^2.0.8",
    "tw-animate-css": "^1.4.0",
    "vaul": "^1.1.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@mswjs/interceptors": "^0.45.9",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/dom": "^10.4.2",
